# Copie ce fichier en .env et remplis les valeurs. Ne publie jamais le .env.

# Génère une clé avec : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Ton nom de domaine, sans https://
DJANGO_ALLOWED_HOSTS=breche.example.fr
DJANGO_CSRF_TRUSTED_ORIGINS=https://breche.example.fr

# Mot de passe de la base PostgreSQL (docker-compose)
POSTGRES_PASSWORD=

# Règles du jeu
BRECHE_TEAM_MAX_SIZE=4
BRECHE_MAX_ATTEMPTS_PER_MINUTE=8
BRECHE_FLAG_FORMAT=BRCH{...}
